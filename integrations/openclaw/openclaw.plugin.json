{
  "id": "agentmemory",
  "kind": "memory",
  "name": "agentmemory",
  "description": "Persistent cross-session memory for OpenClaw via agentmemory.",
  "version": "0.9.30",
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "enabled": { "type": "boolean" },
      "base_url": { "type": "string" },
      "token_budget": { "type": "integer", "minimum": 0, "maximum": 32000 },
      "min_confidence": { "type": "number", "minimum": 0, "maximum": 1 },
      "fallback_on_error": { "type": "boolean" },
      "timeout_ms": { "type": "integer", "minimum": 1, "maximum": 60000 }
    }
  },
  "uiHints": {
    "enabled": { "label": "Enabled" },
    "base_url": { "label": "Base URL", "help": "agentmemory REST server base URL" },
    "token_budget": { "label": "Token Budget", "help": "Approximate injected context budget (4 UTF-8 bytes per token); 0 disables recall" },
    "min_confidence": { "label": "Min Confidence", "help": "Minimum normalized retrieval score, between 0 and 1" },
    "fallback_on_error": { "label": "Fallback On Error" },
    "timeout_ms": { "label": "Timeout (ms)" }
  }
}
